# Isolated hosting trial: no deployment credentials are included in this image.
# Vercel discovers this file automatically and forwards HTTP/WebSocket traffic.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    F1_ENABLE_RACE_IMPORT=0 \
    F1_WEBSOCKET_SCREENSHOT_UPLOAD=1 \
    F1_PUBLIC_GITHUB_SYNC=1 \
    F1_PUBLIC_DASHBOARD_URL=https://f1puskasleague.vercel.app/

WORKDIR /app

# OpenCV and ONNX Runtime need these shared libraries for optional local OCR.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY ["requirements.txt", "requirements-import.txt", "./"]
RUN python -m pip install --no-cache-dir -r requirements.txt

# Keep explicit sources: never replace these with COPY . or a root wildcard.
COPY ["app.py", "dashboard_page.py", "dashboard_core.py", "puskas_html.py", "./"]
COPY ["admin_app.py", "admin_page.py", "admin_auth.py", "admin_management_ui.py", "./"]
COPY ["league_config.py", "league_runtime.py", "league_workbook.py", "./"]
COPY ["race_correction.py", "race_github.py", "race_import.py", "race_import_ui.py", "./"]
COPY ["race_metadata.py", "race_ocr.py", "race_workbook.py", "./"]
COPY ["ui_preferences.py", "public_workbook.py", "hosted_settings.py", "vercel_start.py", "./"]
COPY ["vercel_upload_gate.py", "secure_image_upload.py", "./"]
COPY ["review_draft_recovery.py", "./"]
COPY ["F1_Standings.xlsx", "./"]
COPY [".streamlit/config.toml", "./.streamlit/config.toml"]
COPY ["assets/hero_banner.webp", "./assets/hero_banner.webp"]
COPY ["assets/helmets/", "./assets/helmets/"]
COPY ["assets/tracks/", "./assets/tracks/"]

EXPOSE 80
# Runtime-only secrets are never baked into the image; the launcher execs Streamlit.
CMD ["python", "vercel_start.py"]
